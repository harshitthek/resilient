# =====================================================================
# Resilient — Environment Variable Configuration
# =====================================================================
# Copy this file to '.env' and fill in your credentials.
# Environment variables are automatically loaded at runtime by dotenv.

# ---------------------------------------------------------------------
# 1. PostgreSQL Orchestration Database (All Stages)
# ---------------------------------------------------------------------
# Connection string for PostgreSQL database containing schema.sql tables
DATABASE_URL=postgresql://postgres:password@localhost:5432/resilient

# ---------------------------------------------------------------------
# 2. Stage 1: Repository & Issue Discovery
# ---------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with 'public_repo' or 'repo' scope.
# Note: Do NOT use default GITHUB_TOKEN as it is scoped to a single repo.
DISCOVERY_GH_TOKEN=ghp_your_discovery_token_here
GITHUB_SCAN_TOKEN=ghp_your_discovery_token_here

# Secret set when creating the GitHub App webhook (verifies HMAC signatures)
GITHUB_WEBHOOK_SECRET=your_hmac_webhook_secret_here

# ---------------------------------------------------------------------
# 3. Stage 2: Multi-Model Agent Dispatch (100% Free Tier Priority)
# ---------------------------------------------------------------------
# GitHub PAT with 'repo' scope (used to fork candidate repos & push branches)
DISPATCH_GH_TOKEN=ghp_your_dispatch_token_here
GITHUB_DISPATCH_TOKEN=ghp_your_dispatch_token_here

# --- 100% FREE TIER AGENTS ---
# Google AI Studio Key (Gemini 2.5 Flash / Gemini 2.5 Pro - 100% Free Tier)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Groq Cloud API Key (Llama 3.3 70B Versatile - 100% Free High-Speed Tier)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key (Qwen 2.5 Coder 32B Free, DeepSeek R1 Free - 100% Free Tier)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Cerebras Cloud API Key (Llama 3.3 70B - Ultra-Fast 2000+ tok/s Free Tier)
CEREBRAS_API_KEY=csk_your_cerebras_key_here

# SambaNova Cloud API Key (Llama 3.3 70B, DeepSeek R1 - High-Speed Free Tier)
SAMBANOVA_API_KEY=your_sambanova_key_here

# Mistral AI / Codestral API Key (Codestral SOTA Code Generation)
MISTRAL_API_KEY=your_mistral_api_key_here

# Hugging Face Free Serverless Token (100% Free - No Credit Card: Qwen 2.5 Coder, Llama 3.3 70B)
HF_TOKEN=hf_your_huggingface_token_here

# Cohere Cloud Free Developer Tier (1000 free calls/mo - No Credit Card: Command R+)
COHERE_API_KEY=your_cohere_key_here

# NVIDIA NIM / NVIDIA Build Free Developer Tier (1000 free credits - No Credit Card: Llama 3.3 70B, Nemotron)
NVIDIA_API_KEY=nvapi-your_nvidia_key_here

# Local Open-Source Ollama Agent (Qwen 2.5 Coder, DeepSeek R1 - 100% Free Local)
ENABLE_OLLAMA=0
OLLAMA_HOST=http://localhost:11434

# --- OPTIONAL CLOUD PAID MODEL KEYS ---
OPENAI_API_KEY=sk-proj-your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key_here
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
JULES_API_KEY=

# ---------------------------------------------------------------------
# 4. Stage 4: Authenticated Upstream PR Submission (GitHub App)
# ---------------------------------------------------------------------
# Credentials for the resilient-bot GitHub App (RS256 JWT Authentication)
GH_APP_ID=123456
GH_APP_INSTALLATION_ID=789012
# Private Key PEM format with newlines escaped as \n
GH_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# ---------------------------------------------------------------------
# 5. Stage 5: Leaderboard Dashboard REST API Server
# ---------------------------------------------------------------------
# Host & Port for FastAPI REST API server
HOST=127.0.0.1
PORT=8000
