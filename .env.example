# Copy to .env and fill in -- discover.py and webhook_receiver.py both
# read these from the environment, not from this file directly.

# PAT (classic or fine-grained), public_repo scope. NOT the Actions
# default GITHUB_TOKEN -- that one is scoped to a single repo.
GITHUB_SCAN_TOKEN=

# Postgres connection string, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Set when creating the GitHub App webhook. Used to verify incoming
# webhook payloads via HMAC -- keep this secret.
GITHUB_WEBHOOK_SECRET=

# Only used by webhook_receiver.py when run directly (python webhook_receiver.py).
# Ignored when running under gunicorn.
PORT=8000

# --- Dispatch stage (scripts/dispatch.py) ---

# PAT with `repo` scope -- needs to fork repos and push branches.
# Can be the same token as GITHUB_SCAN_TOKEN if it has sufficient scope.
GITHUB_DISPATCH_TOKEN=

# Google AI Studio API key. Used for the Gemini function-calling
# coding agent (gemini-2.5-pro / gemini-2.5-flash).
GEMINI_API_KEY=
